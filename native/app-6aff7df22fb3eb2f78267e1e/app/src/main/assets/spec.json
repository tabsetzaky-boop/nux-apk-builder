{
  "version": 2,
  "app": {
    "name": "متجر نوكس",
    "tagline": "تسوق أحدث المنتجات بكل سهولة وسرعة",
    "package": "com.nux.app",
    "description": "تطبيق متجر إلكتروني متكامل للبيع والشراء مع لوحة تحكم لإدارة المنتجات والطلبات وإتمام الشراء.",
    "icon": "📱",
    "iconBackground": "#10B981",
    "iconForeground": "#FFFFFF",
    "adaptive": true
  },
  "theme": {
    "primary": "#10B981",
    "background": "#F9FAFB",
    "surface": "#FFFFFF",
    "text": "#111827",
    "dark": false,
    "radius": 16
  },
  "start": "home",
  "screens": [
    {
      "id": "home",
      "title": "الرئيسية",
      "icon": "🏠",
      "subtitle": "تصفح أحدث العروض والمنتجات",
      "components": [
        {
          "type": "banner",
          "text": "🔥 خصم 20% على المنتجات الأكثر مبيعاً هذا الأسبوع!"
        },
        {
          "type": "chips",
          "items": [
            "الكل",
            "إلكترونيات",
            "ملابس",
            "عطور",
            "منزلية"
          ]
        },
        {
          "type": "heading",
          "text": "المنتجات المتاحة"
        },
        {
          "type": "list",
          "source": "product",
          "titleField": "title",
          "subtitleField": "price",
          "empty": "لا توجد منتجات حالياً، أضف بعض المنتجات من لوحة الإدارة",
          "removable": false,
          "action": {
            "type": "none"
          }
        },
        {
          "type": "button",
          "label": "عرض السلة الشراء",
          "action": {
            "type": "navigate",
            "target": "cart"
          }
        }
      ]
    },
    {
      "id": "cart",
      "title": "تفاصيل المنتج والسلة",
      "icon": "🛒",
      "subtitle": "مراجعة المشتريات وإدارتها",
      "components": [
        {
          "type": "heading",
          "text": "سلة المشتريات"
        },
        {
          "type": "list",
          "source": "cart_item",
          "titleField": "product_id",
          "subtitleField": "price",
          "empty": "سلة الشراء فارغة حالياً",
          "removable": true,
          "action": {
            "type": "none"
          }
        },
        {
          "type": "divider"
        },
        {
          "type": "heading",
          "text": "إضافة منتج للسلة سريعاً"
        },
        {
          "type": "form",
          "fields": [
            {
              "field": "product_id",
              "label": "اسم المنتج",
              "placeholder": "أدخل اسم المنتج",
              "secure": false
            },
            {
              "field": "price",
              "label": "السعر (ر.س)",
              "placeholder": "150",
              "secure": false
            },
            {
              "field": "quantity",
              "label": "الكمية",
              "placeholder": "1",
              "secure": false
            }
          ],
          "submitLabel": "إضافة إلى السلة",
          "action": {
            "type": "add",
            "data": "cart_item"
          }
        },
        {
          "type": "button",
          "label": "الانتقال لإتمام الطلب",
          "action": {
            "type": "navigate",
            "target": "checkout"
          }
        }
      ]
    },
    {
      "id": "checkout",
      "title": "إتمام الطلب",
      "icon": "💳",
      "subtitle": "إدخال بيانات الشحن والدفع",
      "components": [
        {
          "type": "heading",
          "text": "تفاصيل الشحن والتوصيل"
        },
        {
          "type": "form",
          "fields": [
            {
              "field": "user_id",
              "label": "اسم العميل",
              "placeholder": "أدخل اسمك الكامل",
              "secure": false
            },
            {
              "field": "shipping_address",
              "label": "عنوان الشحن",
              "placeholder": "المدينة، الحي، الشارع",
              "secure": false
            },
            {
              "field": "total_price",
              "label": "المبلغ الإجمالي (ر.س)",
              "placeholder": "300",
              "secure": false
            },
            {
              "field": "status",
              "label": "حالة الطلب",
              "placeholder": "قيد الانتظار",
              "secure": false
            },
            {
              "field": "created_at",
              "label": "تاريخ الطلب",
              "placeholder": "2023-10-25",
              "secure": false
            }
          ],
          "submitLabel": "تأكيد ودفع الطلب",
          "action": {
            "type": "add",
            "data": "order"
          }
        },
        {
          "type": "button",
          "label": "العودة للرئيسية",
          "action": {
            "type": "navigate",
            "target": "home"
          }
        }
      ]
    },
    {
      "id": "profile",
      "title": "طلباتي والملف الشخصي",
      "icon": "👤",
      "subtitle": "إدارة الحساب ومتابعة الطلبات",
      "components": [
        {
          "type": "card",
          "title": "حساب العميل",
          "text": "مرحباً بك في متجر نوكس. يمكنك متابعة كافة طلباتك السابقة من هنا.",
          "action": {
            "type": "none"
          }
        },
        {
          "type": "heading",
          "text": "تسجيل / تحديث بيانات الحساب"
        },
        {
          "type": "form",
          "fields": [
            {
              "field": "name",
              "label": "الاسم الكامل",
              "placeholder": "محمد أحمد",
              "secure": false
            },
            {
              "field": "email",
              "label": "البريد الإلكتروني",
              "placeholder": "example@domain.com",
              "secure": false
            },
            {
              "field": "phone",
              "label": "رقم الهاتف",
              "placeholder": "0500000000",
              "secure": false
            },
            {
              "field": "is_admin",
              "label": "هل أنت مشرف؟ (نعم/لا)",
              "placeholder": "لا",
              "secure": false
            }
          ],
          "submitLabel": "حفظ البيانات",
          "action": {
            "type": "add",
            "data": "user"
          }
        },
        {
          "type": "heading",
          "text": "سجل الطلبات السابقة"
        },
        {
          "type": "list",
          "source": "order",
          "titleField": "user_id",
          "subtitleField": "status",
          "empty": "لا توجد طلبات سابقة في حسابك",
          "removable": false,
          "action": {
            "type": "none"
          }
        }
      ]
    },
    {
      "id": "admin",
      "title": "لوحة الإدارة",
      "icon": "⚙️",
