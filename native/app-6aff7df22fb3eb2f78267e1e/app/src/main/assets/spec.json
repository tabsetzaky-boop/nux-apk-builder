              "secure": false
            }
          ],
          "submitLabel": "نشر المنتج",
          "action": {
            "type": "add",
            "data": "product"
          }
        },
        {
          "type": "heading",
          "text": "إدارة الطلبات الواردة"
        },
        {
          "type": "list",
          "source": "order",
          "titleField": "shipping_address",
          "subtitleField": "total_price",
